OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
DATABASE_PATH=data/chat.db
CONTEXT_TOKENS=8192
OUTPUT_TOKENS=4096
GENERATION_TIMEOUT=300

# Local use needs no authentication. Hosting requires production mode and a password.
APP_ENV=development
AUTH_USERNAME=
AUTH_PASSWORD=
# Comma-separated HTTPS origins for custom domains; no trailing slash.
ALLOWED_ORIGINS=
# Optional remote Ollama bearer token. Backend only; never set VITE_* secrets.
OLLAMA_API_KEY=
