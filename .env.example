# ==========================================
# Forma Configuration
# ==========================================

# Core database and context settings
DATABASE_PATH=data/chat.db
CONTEXT_TOKENS=8192
OUTPUT_TOKENS=4096
GENERATION_TIMEOUT=300

# Local AI Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# Cloud AI Providers (High-speed & Frontier Intelligence)
# You can set them here OR enter them directly in the UI Settings dialog!
GROQ_API_KEY=          # Free & ultra-fast (300+ tok/s): https://console.groq.com/keys
OPENAI_API_KEY=        # GPT-4o, GPT-4o-mini: https://platform.openai.com/api-keys
GEMINI_API_KEY=        # Gemini 2.0 Flash: https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=    # Claude 3.5 Sonnet, DeepSeek R1: https://openrouter.ai/keys

# Security & Hosting (Required in production)
APP_ENV=development
AUTH_USERNAME=
AUTH_PASSWORD=
ALLOWED_ORIGINS=

# File Attachments & Document Extraction
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=25

# Optional Web Search Providers (DuckDuckGo is active by default with zero keys required)
SEARCH_PROVIDER=duckduckgo # Options: duckduckgo, tavily, brave, disabled
TAVILY_API_KEY=            # https://tavily.com
BRAVE_API_KEY=             # https://brave.com/search/api/
SERPAPI_API_KEY=           # https://serpapi.com

